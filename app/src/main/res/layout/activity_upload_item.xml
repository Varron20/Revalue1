<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#e0e8e3"
    tools:context="com.example.myapplication.market.UploadItemActivity">

    <!-- Top Header Image -->
    <ImageView
        android:id="@+id/headerImage"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:scaleType="centerCrop"
        android:src="@mipmap/home2_foreground" 
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Back Button -->
    <ImageView
        android:id="@+id/backBtn"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_chevron_left"
        android:padding="4dp"
        app:layout_constraintTop_toBottomOf="@id/headerImage"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="10dp"
        android:layout_marginStart="18dp" />

    <!-- Title -->
    <TextView
        android:id="@+id/titleUpload"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Upload Item"
        android:textSize="32sp"
        android:textStyle="italic"
        android:layout_marginTop="20dp"
        android:textColor="#000"
        app:layout_constraintTop_toBottomOf="@id/headerImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Item Image -->
    <ImageView
        android:id="@+id/itemImage"
        android:layout_width="0dp"
        android:layout_height="240dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="18dp"
        android:background="@drawable/bg_product_image"
        android:scaleType="centerCrop"
        android:src="@mipmap/uplaod_foreground"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titleUpload" />

    <!-- Item Name Field -->
    <EditText
        android:id="@+id/itemName"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:hint="Item Name"
        android:background="@drawable/inputroundedbackground"
        android:padding="15dp"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/itemImage"
        android:layout_marginTop="20dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Category Field -->

    <!-- Condition Field -->

    <!-- Description Field -->

    <!-- Upload Button -->

    <EditText
        android:id="@+id/categoryField"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="18dp"
        android:background="@drawable/inputroundedbackground"
        android:hint="Category"
        android:padding="15dp"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/itemName" />

    <EditText
        android:id="@+id/descriptionField"
        android:layout_width="383dp"
        android:layout_height="69dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="18dp"
        android:background="@drawable/inputroundedbackground"
        android:gravity="top"
        android:hint="Description"
        android:padding="15dp"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/conditionField" />

    <EditText
        android:id="@+id/conditionField"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="18dp"
        android:background="@drawable/inputroundedbackground"
        android:hint="Conditions"
        android:padding="15dp"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/categoryField" />

    <Button
        android:id="@+id/uploadBtn"
        android:layout_width="190dp"
        android:layout_height="50dp"
        android:text="Upload Item"
        android:textSize="18sp"
        android:textColor="#FFF"
        android:backgroundTint="#5c7162"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toBottomOf="@id/descriptionField"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>