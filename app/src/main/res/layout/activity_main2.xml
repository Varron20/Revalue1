<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#e0e8e3">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Top image -->

        <ImageView
            android:id="@+id/topBanner"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="21dp"
            android:scaleType="centerCrop"
            android:src="@mipmap/home2_foreground" />

        <androidx.cardview.widget.CardView
            android:id="@+id/card1"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="150dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            app:cardCornerRadius="29dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#eeece0">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Small image left -->

                <!-- Title -->

                <ImageView
                    android:id="@+id/img1"
                    android:layout_width="82dp"
                    android:layout_height="67dp"
                    android:layout_marginLeft="0dp"
                    android:layout_marginTop="30dp"
                    android:scaleType="center"
                    android:scaleX="1.2"
                    android:scaleY="1.2"
                    android:src="@mipmap/a1" />

                <!-- Description -->
                <TextView
                    android:id="@+id/title1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="3dp"
                    android:layout_marginTop="25dp"
                    android:layout_toRightOf="@id/img1"
                    android:fontFamily=""
                    android:text="Discover Renewed Value"
                    android:textColor="#000"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/desc1"
                    android:layout_width="302dp"
                    android:layout_height="80dp"
                    android:layout_below="@id/title1"
                    android:layout_marginLeft="6dp"
                    android:layout_marginTop="11dp"
                    android:layout_toRightOf="@id/img1"
                    android:fontFamily=""
                    android:text="Shop high-quality renewed items and give products a second life."
                    android:textColor="#000"
                    android:textSize="24sp" />
            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/card2"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_below="@id/card1"
            android:layout_marginTop="20dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            app:cardCornerRadius="29dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#eeece0">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/img2"
                    android:layout_width="80dp"
                    android:layout_height="93dp"
                    android:layout_marginLeft="0dp"
                    android:layout_marginTop="30dp"
                    android:scaleType="centerCrop"
                    android:src="@mipmap/b_foreground" />

                <TextView
                    android:id="@+id/title2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="3dp"
                    android:layout_marginTop="25dp"
                    android:layout_toRightOf="@id/img2"
                    android:text="Shop Smart -> Save More"
                    android:textColor="#000"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/desc2"
                    android:layout_width="266dp"
                    android:layout_height="58dp"
                    android:layout_below="@id/title2"
                    android:layout_marginLeft="6dp"
                    android:layout_marginTop="11dp"
                    android:layout_toRightOf="@id/img2"
                    android:fontFamily=''
                    android:text="Find great items at affordable prices while helping reduce waste."
                    android:textColor="#000"
                    android:textSize="24sp" />
            </RelativeLayout>
        </androidx.cardview.widget.CardView>


        <androidx.cardview.widget.CardView
            android:id="@+id/card3"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_below="@id/card2"
            android:layout_marginTop="20dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            app:cardCornerRadius="29dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#eeece0">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/img3"
                    android:layout_width="85dp"
                    android:layout_height="94dp"
                    android:layout_marginLeft="0dp"
                    android:layout_marginTop="20dp"
                    android:scaleType="centerCrop"
                    android:src="@mipmap/b25_foreground"
                    app:srcCompat="@mipmap/b25_foreground"
                    tools:srcCompat="@mipmap/b25_foreground" />

                <TextView
                    android:id="@+id/title3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="2dp"
                    android:layout_marginTop="25dp"
                    android:layout_toRightOf="@id/img3"
                    android:fontFamily=""
                    android:text="Choose a Greener Future"
                    android:textColor="#000"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/desc3"
                    android:layout_width="283dp"
                    android:layout_height="62dp"
                    android:layout_below="@id/title3"
                    android:layout_marginLeft="6dp"
                    android:layout_marginTop="11dp"
                    android:layout_toRightOf="@id/img3"
                    android:fontFamily=""
                    android:text="Every purchase supports sustainability and helps protect the planet."
                    android:textColor="#000"
                    android:textSize="24sp" />
            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <!-- Join Now Button -->
        <Button
            android:id="@+id/joinNowBtn"
            android:layout_width="220dp"
            android:layout_height="53dp"
            android:layout_below="@id/card3"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="40dp"
            android:backgroundTint="#7ba58a"
            android:fontFamily=""
            android:text="Join Now"
            android:textColor="#fff"
            android:textSize="22sp" />

    </RelativeLayout>

</ScrollView>