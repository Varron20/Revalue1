            android:name="com.example.myapplication.Profile.ProfileActivity"
            android:exported="false" />
        <activity
            android:name="com.example.myapplication.Profile.NotificationActivity"
            android:exported="false" />
        <activity
            android:name="com.example.myapplication.market.MarketplaceActivity"
            android:exported="false" />
